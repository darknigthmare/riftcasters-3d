{
  "name": "riftcasters-3d",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.static.config.ts",
    "build": "vite build --config vite.static.config.ts",
    "preview": "vite preview --config vite.static.config.ts",
    "start": "vite preview --config vite.static.config.ts --host 0.0.0.0",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest --config vitest.config.ts run",
    "qa": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "^5.0.0"
  },
  "type": "module"
}
